############################################################
# PopSushi — local dev environment variables
#
# Copy to .env, then run ./scripts/gen-keys.sh to fill the
# blanks with fresh secrets. Do NOT commit your .env.
############################################################

############
# Secrets (populated by ./scripts/gen-keys.sh)
############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
NOMINATIM_PASSWORD=

# Opaque API keys (new Supabase path) — left empty; kong falls back to legacy HS256
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
JWT_KEYS=
JWT_JWKS=

# Storage S3 protocol credentials (unused with file backend, but required env)
S3_PROTOCOL_ACCESS_KEY_ID=local-dev-access
S3_PROTOCOL_ACCESS_KEY_SECRET=local-dev-secret

# Studio basic-auth gate (accessed directly at :54323 so rarely used)
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

############
# Public URLs
############
SUPABASE_PUBLIC_URL=http://localhost:54321
API_EXTERNAL_URL=http://localhost:54321
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/auth/callback

############
# Kong API gateway
############
KONG_HTTP_PORT=54321
KONG_HTTPS_PORT=54443

############
# Postgres
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

############
# Auth (GoTrue)
############
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
# Set true for faster demo signups (skips email confirmation)
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############
# SMTP — Inbucket mail catcher (in-docker)
############
SMTP_HOST=inbucket
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@popsushi.local
SMTP_SENDER_NAME=PopSushi

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=PopSushi
STUDIO_DEFAULT_PROJECT=popsushi-local

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,storage
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# imgproxy
############
IMGPROXY_AUTO_WEBP=true

############
# Storage (file backend)
############
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub

############
# Nominatim — self-hosted geocoder (opt-in via --profile geo)
############
# Pick your bbox from https://download.geofabrik.de/
# Default Monaco (~1.5MB, ~1 min import) is intentionally tiny so the stack
# boots quickly on first run. Swap for your target city before Phase 2.
#   San Francisco Bay area: https://download.geofabrik.de/north-america/us/california-latest.osm.pbf
#   New York:               https://download.geofabrik.de/north-america/us/new-york-latest.osm.pbf
#   Tokyo / Kanto:          https://download.geofabrik.de/asia/japan/kanto-latest.osm.pbf
NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf

############
# Web app — browser-visible (must be prefixed NEXT_PUBLIC_)
############
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_NOMINATIM_URL=http://localhost:54325

############
# Web app — server-only (never prefix NEXT_PUBLIC_)
############
# Inside the web container, use the in-network Kong hostname.
SUPABASE_URL=http://kong:8000
